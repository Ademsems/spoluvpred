# Copy to .env.local (never commit real values).

# Public origin of the deployed site (used for metadataBase / Open Graph).
NEXT_PUBLIC_SITE_URL=https://example.org

# Contact form delivery via Resend (https://resend.com). Without RESEND_API_KEY the
# form shows its "write to us directly" fallback in production.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "Spolu Vpred web <web@your-domain.sk>".
CONTACT_FROM_EMAIL=
# Defaults to info.spoluvpred@gmail.com when empty.
CONTACT_TO_EMAIL=
